---
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../lib/site";
---

<BaseLayout
  title="Page not found — Vizier"
  description="That page is not in the court."
  noindex
>
  <section class="section">
    <div class="shell" style="display:flex;flex-direction:column;align-items:flex-start;gap:22px;max-width:44rem">
      <p class="mono-label">404 · NOT IN THE COURT</p>
      <h1 class="display-lg">That page is<br />not in the court.</h1>
      <p class="lede">
        The link may be old, or the page may have moved into the documentation.
        Start from the docs home and search for what you need.
      </p>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <a class="btn btn-primary" href={url("/docs/")}>Documentation</a>
        <a class="btn btn-secondary" href={url("/")}>Home</a>
      </div>
    </div>
  </section>
</BaseLayout>
