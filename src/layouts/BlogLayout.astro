---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../lib/site";

type Props = {
  post: CollectionEntry<"blog">;
};

const { post } = Astro.props;
const slug = post.id.replace(/\.md$/, "");

const all = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const index = all.findIndex((entry) => entry.id === post.id);
const newer = index > 0 ? all[index - 1] : undefined;
const older = index >= 0 && index < all.length - 1 ? all[index + 1] : undefined;

const words = (post.body ?? "").split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));

const dateFormat = new Intl.DateTimeFormat("en", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
const date = dateFormat.format(post.data.date);
const updated =
  post.data.updated && post.data.updated.valueOf() !== post.data.date.valueOf()
    ? dateFormat.format(post.data.updated)
    : null;
---

<BaseLayout
  title={`${post.data.title} — Vizier`}
  description={post.data.description}
  type="article"
>
  <article class="post">
    <div class="shell">
      <header class="post__header">
        <p class="mono-label">FROM THE COURT</p>
        <h1>{post.data.title}</h1>
        <p class="post__description">{post.data.description}</p>
        <div class="post__meta">
          <span>{date}</span>
          {updated && <span>· updated {updated}</span>}
          <span>· {post.data.author}</span>
          <span>· {minutes} min read</span>
          {post.data.tags.map((tag) => <span class="chip">{tag}</span>)}
        </div>
      </header>

      <div class="post__body prose">
        <slot />
      </div>

      <footer class="post__footer">
        <span>{post.data.tags.map((tag) => `#${tag}`).join(" ")}</span>
        <a
          href={`https://github.com/vizier-lab/landing/edit/master/src/content/blog/${slug}.md`}
          target="_blank"
          rel="noopener noreferrer"
        >
          Edit this post
        </a>
      </footer>

      {(newer || older) && (
        <nav class="post-nav" aria-label="More posts">
          {newer ? (
            <a href={url(`/blog/${newer.id.replace(/\.md$/, "")}/`)}>
              <span>Newer</span>
              {newer.data.title}
            </a>
          ) : (
            <span></span>
          )}
          {older ? (
            <a href={url(`/blog/${older.id.replace(/\.md$/, "")}/`)} style="text-align:right">
              <span>Older</span>
              {older.data.title}
            </a>
          ) : (
            <span></span>
          )}
        </nav>
      )}

      <div style="max-width:52rem;margin:40px auto 0">
        <a class="mono" style="font-size:11px;color:var(--vz-live-text)" href={url("/blog/")}>
          ← All posts
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
