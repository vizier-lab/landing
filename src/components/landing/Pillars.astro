---
import { pillars } from "../../data/site";
---

<section class="section">
  <div class="shell">
    <div class="section-head">
      <div class="section-head__copy">
        <h2 class="display-lg">An agent is someone,<br />not a widget.</h2>
      </div>
      <p class="body-copy section-head__note">
        Most assistants reset every time the tab closes, so every correction is
        thrown away. The fix is not a longer context window. It is a record that
        outlives it.
      </p>
    </div>

    <div class="pillars">
      {pillars.map((pillar) => (
        <article class="pillar">
          <h3>{pillar.title}</h3>
          <p>{pillar.body}</p>
          <span class="pillar__note">{pillar.note}</span>
        </article>
      ))}
    </div>
  </div>
</section>
