---
import { Icon } from "@vizier/design";
import { features } from "../../data/site";
import { url } from "../../lib/site";
---

<section class="section" style="padding-top:0">
  <div class="shell">
    <div class="section-head">
      <div class="section-head__copy">
        <h2 class="display-lg">A court that<br />does the work.</h2>
      </div>
      <div class="section-head__aside">
        <p class="body-copy">
          Everything below ships in the same binary. There is no second service to
          stand up, and nothing important is kept where you cannot reach it.
        </p>
        <a class="mono section-head__link" href={url("/docs/configuration/")}>
          Read the configuration docs →
        </a>
      </div>
    </div>

    <div class="features">
      {features.map((feature) => (
        <article class="feature">
          <span class="feature__icon">
            <Icon name={feature.icon} size={15} />
          </span>
          <div class="feature__body">
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
            <span class="feature__meta">{feature.meta}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
