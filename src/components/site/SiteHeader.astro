---
import { nav } from "../../data/site";
import { url, versionLabel, repoUrl } from "../../lib/site";

const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const here = pathname.slice(base.length) || "/";

function isCurrent(href: string) {
  if (href === "/") return here === "/";
  return here.startsWith(href);
}
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href={url("/")} aria-label="Vizier home">
      <img src={url("/favicon.svg")} alt="" width="30" height="30" />
      <span class="brand__name">vizier<span class="brand__dot"></span></span>
    </a>

    <nav class="site-nav" aria-label="Main">
      {nav.map((item) =>
        item.external ? (
          <a class="site-nav__link" href={item.href} target="_blank" rel="noopener noreferrer">
            {item.label}
          </a>
        ) : (
          <a
            class="site-nav__link"
            href={url(item.href)}
            aria-current={isCurrent(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ),
      )}
    </nav>

    <div class="site-header__actions">
      <span class="chip" title="Latest released version">
        <span class="chip-dot"></span>
        {versionLabel}
      </span>
      <a class="btn btn-primary btn-small" href={url("/#install")}>Install</a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle colour theme">
        <svg class="theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6.4 6.4 0 0 0 9 5.8A9 9 0 1 1 12.2 3Z"></path>
        </svg>
        <svg class="theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
      </button>

      <details class="mobile-nav">
        <summary aria-label="Open menu">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <div class="mobile-nav__panel">
          {nav.map((item) => (
            <a
              href={item.external ? item.href : url(item.href)}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener noreferrer" : undefined}
            >
              {item.label}
            </a>
          ))}
          <a href={url("/#install")}>Install</a>
          <a href={repoUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const buttons = document.querySelectorAll("[data-theme-toggle]");
    for (const button of buttons) {
      button.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("starlight-theme", next);
        } catch {}
      });
    }
  })();
</script>
